# dependencies
node_modules
.pnp
.pnp.js

# build output
dist
dist-ssr
*.local

# rust / tauri
src-tauri/target
src-tauri/gen/schemas

# editor / os
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.log

# app data written during dev
/scratch

# local tooling state - never part of the app
.claude

# secrets / credentials - should never exist in this project, excluded
# defensively regardless
.env
.env.*
*.pfx
*.key
secrets.json

# not used by this project (Tauri/Rust/Node, not .NET), excluded
# defensively in case any tooling ever creates them
.vs/
bin/
obj/
